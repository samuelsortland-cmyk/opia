{
  "manifest_version": 3,
  "name": "Opia Link",
  "version": "1.0.0",
  "description": "Lets the Opia 5.5 desktop pet read and work in your open tabs. Talks only to Opia on this computer (127.0.0.1). Payments are blocked.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["guard.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "Opia Link" },
  "icons": { "128": "icon.png" }
}
